# ==============================================================================
# OmniBrand OS: Commercial Environment Configuration (.env.example)
# ==============================================================================

# Application & Host
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CDN_BASE_URL=https://cdn.omnibrand.io

# 1. Database & Supabase (PostgreSQL / Supabase Auth & DB)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key
DATABASE_URL=postgresql://omnibrand:omnibrand_secret@localhost:5432/omnibrand_db?schema=public&sslmode=prefer
DIRECT_URL=postgresql://omnibrand:omnibrand_secret@localhost:5432/omnibrand_db?schema=public

# 2. Redis (BullMQ Queues & Idempotency Store)
REDIS_URL=redis://localhost:6379

# 3. Object Storage (S3 / MinIO / Supabase Storage)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=omnibrand-media-assets
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_USE_SSL=false

# 4. Authentication & Security
AUTH_SECRET=omnibrand_super_secure_auth_session_secret_2026_change_in_prod
OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/callback
GOOGLE_CLIENT_ID=google_client_id_placeholder.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=google_client_secret_placeholder

# 5. KMS Encryption (AES-256-GCM Keyring)
KMS_MASTER_KEY_V1=omnibrand_kms_key_v1_secure_2026_change_in_prod
KMS_MASTER_KEY_V2=omnibrand_kms_key_v2_rotated_2026_change_in_prod

# 6. Third-Party Integration Credentials
AYRSHARE_API_KEY=ayr_live_mock_api_key_778102
SMSCLOUD_HUB_ACCOUNT_ID=acc_smscloud_apex_prod
SMSCLOUD_HUB_AUTH_TOKEN=tok_smscloud_live_secret_4491
WEBHOOK_SHARED_SECRET=omnibrand_webhook_shared_secret_2026

# 7. AI Gateway & Inference Engine
OPENAI_API_KEY=sk-mock-openai-key-for-dalle3
FLUX_API_KEY=flux_live_token_for_flux1_pro
AI_GATEWAY_DEFAULT_MODEL=FLUX_1_PRO

# 8. Observability & Sentry
SENTRY_DSN=https://mock_sentry_key@sentry.io/4910284
LOG_LEVEL=info
